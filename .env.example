# PostgreSQL connection string (Prisma)
DATABASE_URL=
# Optional pooled Prisma connection string
POSTGRES_PRISMA_URL=
# Required random secret for signing session JWTs
JWT_SECRET=
# Optional menu OCR API key (GEMINI_API_KEY takes precedence over GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public application URL; defaults to the request origin
NEXT_PUBLIC_APP_URL=
